ANTHROPIC_API_KEY=

# optional: the planning model and how hard it thinks (low, medium, high, xhigh, max).
# defaults: claude-opus-5-5 at low effort. each run logs its token use and cost so settings can be compared
# PLANNER_MODEL=claude-opus-5-5
# PLANNER_EFFORT=low

# optional: per-visitor limits, per server process
# PLAN_RUNS_PER_HOUR=10
# PLAN_MAX_CONCURRENT=3
# CHECK_RUNS_PER_HOUR=120
# CHECK_MAX_CONCURRENT=6

# optional: where api responses are cached (default .cache). on a read-only disk the cache stays in memory
# CACHE_DIR=
